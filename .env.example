# Browser configuration. Only VITE_* values are bundled into the client.
# Never put a service-role or other private key in a VITE_* variable.
VITE_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Use the canonical production origin on Vercel; no trailing path or slash.
VITE_PUBLIC_SITE_URL=https://your-project.vercel.app

# Optional build configuration used by vite.config.ts
# BASE_PATH=/
# IS_PREVIEW=
# PROJECT_ID=
# VERSION_ID=
# READDY_AI_DOMAIN=

# Supabase Edge Function secrets / server-side scripts only. Set these in the
# Supabase dashboard or secure CI environment; do not set them in Vercel's
# browser build unless that runtime actually executes the server-side script.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Server-side worker secrets and optional Edge Function settings
DOCUMENT_EXTRACTION_WORKER_SECRET=
OPENAI_DOCUMENT_MODEL=
PUBLIC_ASSISTANT_WORKER_SECRET=
PUBLIC_ASSISTANT_EMBEDDING_MODEL=
PUBLIC_ASSISTANT_GENERATION_MODEL=
PUBLIC_ASSISTANT_ENABLE_GENERATION=
PUBLIC_ASSISTANT_DOCUMENT_MAX_BYTES=
PUBLIC_ASSISTANT_DOCUMENT_MAX_PAGES=
PUBLIC_ASSISTANT_DOCUMENT_EXTRACTION_MODEL=
PUBLIC_ASSISTANT_CHUNK_TOKENS=
PUBLIC_ASSISTANT_CHUNK_OVERLAP=

# Local integration-test endpoints only
# LOCAL_SUPABASE_URL=http://127.0.0.1:54321
# LOCAL_FUNCTION_URL=http://127.0.0.1:54325
