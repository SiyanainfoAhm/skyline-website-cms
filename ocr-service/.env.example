# Never expose this value to the browser. In production, only a Supabase Edge
# Function that has already checked the caller's JWT and application access may call this service.
OCR_SERVICE_SHARED_SECRET=replace-with-a-long-random-secret
OCR_MAX_BYTES=10485760
OCR_RATE_LIMIT_PER_MINUTE=12
OCR_ALLOWED_ORIGINS=http://localhost:5173
OCR_MODEL_LANGUAGES=en,chinese_cht,korean
OCR_ENABLE_DEV_UPLOAD=false
